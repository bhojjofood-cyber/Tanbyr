rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Artist Profile collection (Readable & Writable by CMS)
    match /artists/{document=**} {
      allow read, write: if true;
    }

    // Music Releases collection
    match /releases/{document=**} {
      allow read, write: if true;
    }

    // Music Videos collection
    match /musicVideos/{document=**} {
      allow read, write: if true;
    }

    // Photography Gallery collection
    match /photos/{document=**} {
      allow read, write: if true;
    }

    // Social Media Links collection
    match /socialLinks/{document=**} {
      allow read, write: if true;
    }

    // Global Site & SEO Settings collection
    match /siteSettings/{document=**} {
      allow read, write: if true;
    }

    // Admins registry collection
    match /admins/{document=**} {
      allow read, write: if true;
    }

    // Deny all other collections by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
